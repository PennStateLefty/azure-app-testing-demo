<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>LifeCore Suite</title>
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LifeCore.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>

<body>
    <Routes @rendermode="RenderModeNoPrerender" />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Prerendering is disabled so the server host only serves static WASM assets + JSON APIs.
    private static readonly IComponentRenderMode RenderModeNoPrerender = new InteractiveWebAssemblyRenderMode(prerender: false);
}
