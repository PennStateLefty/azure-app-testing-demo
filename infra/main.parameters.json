{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=westus3}" },
    "playwrightLocation": { "value": "${PLAYWRIGHT_LOCATION=eastus}" },
    "sqlAdminObjectId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "sqlAdminLogin": { "value": "${AZURE_PRINCIPAL_NAME}" },
    "sqlAdminPrincipalType": { "value": "User" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "deploymentMode": { "value": "${DEPLOYMENT_MODE=githubActions}" }
  }
}
