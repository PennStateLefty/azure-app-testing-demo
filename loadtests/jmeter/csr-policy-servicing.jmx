        <stringProp name="variableNames">lastName</stringProp>
      </CSVDataSet>
      <hashTree />
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="CSR policy servicing" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__groovy(System.getenv('threads') ?: props.getProperty('threads') ?: '50')}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__groovy(System.getenv('rampup') ?: props.getProperty('rampup') ?: '60')}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__groovy(System.getenv('duration') ?: props.getProperty('duration') ?: '300')}</stringProp>
        <stringProp name="ThreadGroup.delay" />
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
